<?xml version="1.0" encoding="utf-8"?>
<!--
  AirenoOS AutoCAD Plugin — Autodesk autoloader bundle manifest.
  AutoCAD scans %APPDATA%\Autodesk\ApplicationPlugins\*.bundle on startup and
  loads ModuleName for the document whose AutoCAD series matches RuntimeRequirements.
  Series mapping:  AutoCAD 2024 = R24.3   |   AutoCAD 2025 = R25.0   |   AutoCAD 2026 = R25.1
-->
<ApplicationPackage
    SchemaVersion="1.0"
    AutodeskProduct="AutoCAD"
    ProductType="Application"
    Name="AirenoOS Plugin"
    Description="Extracts drawing metadata and syncs it with the AirenoOS MCP backend."
    AppVersion="1.0.4"
    FriendlyVersion="1.0.4"
    Author="AirenoOS"
    AppNameSpace="airenos.io"
    ProductCode="{A1B2C3D4-E5F6-4A1B-9C2D-3E4F5A6B7C8D}"
    UpgradeCode="{F9E8D7C6-B5A4-4321-9876-543210FEDCBA}"
    SupportedLocales="Enu"
    >
  <CompanyDetails Name="AirenoOS" Url="https://airenos.io" Email="hello@airenos.io" />
  <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R24.3" />

  <!-- AutoCAD 2024 (R24.3) — .NET Framework 4.8 build -->
  <Components Description="AirenoOS for AutoCAD 2024">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R24.3" SeriesMax="R24.3" />
    <ComponentEntry
        AppName="AirenoOS.AutoCAD.Plugin"
        Version="1.0.4"
        ModuleName="./Contents/2024/AirenoOS.AutoCAD.Plugin.dll"
        LoadOnAutoCADStartup="True">
      <Commands GroupName="AIRENO">
        <Command Local="AIRENO_CONNECT"   Global="AIRENO_CONNECT"   />
        <Command Local="AIRENO_EXTRACT"   Global="AIRENO_EXTRACT"   />
        <Command Local="AIRENO_WRITEBACK" Global="AIRENO_WRITEBACK" />
      </Commands>
    </ComponentEntry>
  </Components>

  <!-- AutoCAD 2025 (R25.0) — .NET 8 build -->
  <Components Description="AirenoOS for AutoCAD 2025">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R25.0" SeriesMax="R25.0" />
    <ComponentEntry
        AppName="AirenoOS.AutoCAD.Plugin"
        Version="1.0.4"
        ModuleName="./Contents/2025/AirenoOS.AutoCAD.Plugin.dll"
        LoadOnAutoCADStartup="True">
      <Commands GroupName="AIRENO">
        <Command Local="AIRENO_CONNECT"   Global="AIRENO_CONNECT"   />
        <Command Local="AIRENO_EXTRACT"   Global="AIRENO_EXTRACT"   />
        <Command Local="AIRENO_WRITEBACK" Global="AIRENO_WRITEBACK" />
      </Commands>
    </ComponentEntry>
  </Components>

  <!-- AutoCAD 2026 (R25.1) — same .NET 8 build, separate folder for explicit per-version control -->
  <Components Description="AirenoOS for AutoCAD 2026">
    <RuntimeRequirements OS="Win64" Platform="AutoCAD*" SeriesMin="R25.1" SeriesMax="R25.1" />
    <ComponentEntry
        AppName="AirenoOS.AutoCAD.Plugin"
        Version="1.0.4"
        ModuleName="./Contents/2026/AirenoOS.AutoCAD.Plugin.dll"
        LoadOnAutoCADStartup="True">
      <Commands GroupName="AIRENO">
        <Command Local="AIRENO_CONNECT"   Global="AIRENO_CONNECT"   />
        <Command Local="AIRENO_EXTRACT"   Global="AIRENO_EXTRACT"   />
        <Command Local="AIRENO_WRITEBACK" Global="AIRENO_WRITEBACK" />
      </Commands>
    </ComponentEntry>
  </Components>
</ApplicationPackage>
