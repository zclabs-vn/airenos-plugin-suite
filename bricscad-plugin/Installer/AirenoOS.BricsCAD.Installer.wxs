<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX 5 source for the BricsCAD plugin MSI.

  Build with:
    wix build AirenoOS.BricsCAD.Installer.wxs `
      -d PluginDll=..\AirenoOS.BricsCAD.Plugin\bin\Release\net8.0-windows\AirenoOS.BricsCAD.Plugin.dll `
      -ext WixToolset.UI.wixext `
      -o ..\dist\AirenoOS.BricsCAD.Plugin.msi

  After wix build, post-build.ps1 patches the ControlCondition table to enable/
  disable the V25 and V26 checkboxes based on the detection properties — WiX 5
  dropped that syntactic sugar so we inject the rows via WindowsInstaller COM.

  Install layout (per-user, no admin):
    %APPDATA%\Bricsys\ApplicationPlugins\AirenoOS.BricsCAD.bundle\
      PackageContents.xml
      Contents\Windows\AirenoOS.BricsCAD.Plugin.dll
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
      Name="AirenoOS BricsCAD Plugin"
      Manufacturer="AirenoOS"
      Version="1.0.3.0"
      UpgradeCode="C3D1A5A2-AFE6-4F1A-9B0E-A1A2A3A4A5A6"
      Scope="perUser"
      Compressed="yes"
      InstallerVersion="500">

    <SummaryInformation
        Description="AirenoOS metadata sync plugin for BricsCAD V25 and V26"
        Keywords="AirenoOS;BricsCAD;Plugin;MCP" />

    <!-- AllowSameVersionUpgrades: each wix build generates a fresh ProductCode, so a
         rebuild at the SAME version must still remove the prior install instead of
         stacking a second Add/Remove-Programs entry. -->
    <MajorUpgrade
        AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of [ProductName] is already installed." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Friendly product info shown in Add/Remove Programs -->
    <Property Id="ARPHELPLINK" Value="https://zclabs.vn" />
    <Property Id="ARPURLINFOABOUT" Value="https://zclabs.vn" />

    <!-- ───────────────────────────────────────────────────────────────────────
         BricsCAD detection — Brian #10
         Probe both V25 and V26 install paths so a single MSI works against either
         release. BRICSCAD_VXX_FOUND is set to the bricscad.exe path when found.
         ─────────────────────────────────────────────────────────────────────── -->
    <Property Id="BRICSCAD_V25_FOUND" Secure="yes">
      <DirectorySearch Id="BricscadV25PathSearch" Path="[ProgramFiles64Folder]Bricsys\BricsCAD V25 en_US" Depth="0">
        <FileSearch Id="BricscadV25ExeSearch" Name="bricscad.exe" />
      </DirectorySearch>
    </Property>
    <Property Id="BRICSCAD_V26_FOUND" Secure="yes">
      <DirectorySearch Id="BricscadV26PathSearch" Path="[ProgramFiles64Folder]Bricsys\BricsCAD V26 en_US" Depth="0">
        <FileSearch Id="BricscadV26ExeSearch" Name="bricscad.exe" />
      </DirectorySearch>
    </Property>

    <!-- Checkbox-bound install flags. Empty = unchecked, "1" = checked.
         Default unchecked; SetProperty below ticks whichever versions were detected. -->
    <Property Id="INSTALL_V25" Secure="yes" />
    <Property Id="INSTALL_V26" Secure="yes" />

    <SetProperty Id="INSTALL_V25" Value="1" After="AppSearch" Condition="BRICSCAD_V25_FOUND" Sequence="ui" />
    <SetProperty Id="INSTALL_V26" Value="1" After="AppSearch" Condition="BRICSCAD_V26_FOUND" Sequence="ui" />

    <!-- Status labels next to each checkbox — flips to "(detected)" when the
         corresponding bricscad.exe was found at AppSearch time. -->
    <Property Id="STATUS_V25" Value="(not installed)" />
    <Property Id="STATUS_V26" Value="(not installed)" />
    <SetProperty Id="STATUS_V25" Value="(detected)" After="AppSearch" Condition="BRICSCAD_V25_FOUND" Sequence="ui" />
    <SetProperty Id="STATUS_V26" Value="(detected)" After="AppSearch" Condition="BRICSCAD_V26_FOUND" Sequence="ui" />

    <!-- Refuse to launch if zero BricsCAD versions are present on the machine. -->
    <Launch Condition="BRICSCAD_V25_FOUND OR BRICSCAD_V26_FOUND"
            Message="Neither BricsCAD V25 nor V26 was detected in &quot;C:\Program Files\Bricsys\&quot;. Install BricsCAD first, then re-run this installer." />

    <!-- ───────────────────────────────────────────────────────────────────────
         Install layout — per-user bundle under %LOCALAPPDATA%\Bricsys\ApplicationPlugins\.
         Bundle autoloading on V25 doesn't work regardless of path (see
         bricscad-v25-loader-quirks memory); we register the assembly via
         HKCU\Software\Bricsys\BricsCAD\<ver>x64\en_US\Applications\AirenoOS so
         the install location only has to be reachable by the LOADER path —
         %LOCALAPPDATA% is per-user writable without admin/UAC.

         Two host-specific subfolders so each BricsCAD edition loads the DLL
         compiled for its CLR:
           Contents/V25/  → .NET Framework 4.8 DLL + 9 NuGet System.* DLLs
           Contents/V26/  → .NET 8 DLL (self-contained against net8 BCL)
         ─────────────────────────────────────────────────────────────────────── -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="BricsysFolder" Name="Bricsys">
        <Directory Id="AppPluginsFolder" Name="ApplicationPlugins">
          <Directory Id="BundleFolder" Name="AirenoOS.BricsCAD.bundle">
            <Directory Id="ContentsFolder" Name="Contents">
              <Directory Id="BundleV25SubFolder" Name="V25" />
              <Directory Id="BundleV26SubFolder" Name="V26" />
            </Directory>
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- Single feature — gated by "at least one version ticked". Feature.Level=0
         hides+skips the install when both checkboxes are clear, which lets the
         user explicitly opt out (e.g. uninstalling before re-installing with
         different version selection). -->
    <Feature Id="Main" Title="AirenoOS BricsCAD Plugin" Level="1" Display="expand">
      <Level Value="0" Condition="NOT INSTALL_V25 AND NOT INSTALL_V26" />
      <ComponentGroupRef Id="BundleFiles" />
    </Feature>

    <!-- ───────────────────────────────────────────────────────────────────────
         Custom UI: insert VersionSelectDlg into WixUI_FeatureTree's flow.
         Wizard order: Welcome → License → SelectVersions → Verify → Progress → Finish
         ─────────────────────────────────────────────────────────────────────── -->
    <ui:WixUI Id="WixUI_FeatureTree" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <UI>
      <Dialog Id="VersionSelectDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="{\WixUI_Font_Title}Select BricsCAD Versions" />
        <Control Id="Subtitle" Type="Text" X="25" Y="23" Width="320" Height="15" Transparent="yes" NoPrefix="yes"
                 Text="Choose which BricsCAD versions to install the plugin for." />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="LicenseAgreementDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>

        <!-- ── BricsCAD V25 ───────────────────────────────────────── -->
        <Control Id="CbV25" Type="CheckBox" X="30" Y="80" Width="200" Height="17"
                 Property="INSTALL_V25" CheckBoxValue="1" Text="BricsCAD &amp;V25" />
        <Control Id="StV25" Type="Text" X="240" Y="81" Width="120" Height="15" Transparent="yes"
                 Text="[STATUS_V25]" />

        <!-- ── BricsCAD V26 ───────────────────────────────────────── -->
        <Control Id="CbV26" Type="CheckBox" X="30" Y="120" Width="200" Height="17"
                 Property="INSTALL_V26" CheckBoxValue="1" Text="BricsCAD V2&amp;6" />
        <Control Id="StV26" Type="Text" X="240" Y="121" Width="120" Height="15" Transparent="yes"
                 Text="[STATUS_V26]" />

        <Control Id="Hint" Type="Text" X="30" Y="170" Width="320" Height="40" Transparent="yes" NoPrefix="yes"
                 Text="Versions marked (detected) are pre-selected. The plugin bundle is installed once to %APPDATA% and BricsCAD auto-loads it on startup — both ticked just keeps the bundle enabled for both editions." />
      </Dialog>

      <!-- Wire VersionSelectDlg into the flow: License → SelectVersions → Verify -->
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="VersionSelectDlg"
               Order="3" Condition="LicenseAccepted = &quot;1&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="VersionSelectDlg" Order="3" />
    </UI>
  </Package>

  <Fragment>
    <ComponentGroup Id="BundleFiles">
      <!-- PackageContents.xml at the bundle root — read by BricsCAD on startup.
           Per-user components must declare an HKCU registry KeyPath (ICE57), so the
           file itself is no longer KeyPath. -->
      <!-- perMachine scope: file can be KeyPath directly (no HKCU registry trick). -->
      <Component Id="C_PackageContents" Directory="BundleFolder">
        <File
            Id="F_PackageContents"
            Name="PackageContents.xml"
            Source="PackageContents.xml"
            KeyPath="yes" />
        <RemoveFolder Id="RemoveBundleRoot"   On="uninstall" />
        <RemoveFolder Id="RemoveAppPlugins"   Directory="AppPluginsFolder" On="uninstall" />
        <RemoveFolder Id="RemoveBricsysRoot"  Directory="BricsysFolder"    On="uninstall" />
        <RemoveFolder Id="RemoveContentsDir"  Directory="ContentsFolder"   On="uninstall" />
        <RemoveFolder Id="RemoveV25Dir"       Directory="BundleV25SubFolder" On="uninstall" />
        <RemoveFolder Id="RemoveV26Dir"       Directory="BundleV26SubFolder" On="uninstall" />
      </Component>

      <!-- BricsCAD V25 host (.NET Framework 4.8).
           net48 builds aren't self-contained: System.Text.Json + 8 transitive
           NuGet DLLs ship alongside the plugin DLL. Without these, BricsCAD V25
           NETLOADs the plugin but HttpSender's static ctor throws
           TypeInitializationException (verified 2026-06-16 in session_end.log)
           and no payload ever leaves the host. <Files> globs every *.dll the
           build emits into bin\x64\Release\net48\ (= Stage\V25 after copy). -->
      <Files Directory="BundleV25SubFolder" Include="$(var.PluginDirV25)\*.dll" />

      <!-- BricsCAD V26 host (.NET 8) -->
      <Component Id="C_PluginDllV26" Directory="BundleV26SubFolder">
        <File
            Id="F_PluginDllV26"
            Name="AirenoOS.BricsCAD.Plugin.dll"
            Source="$(var.PluginDllV26)"
            KeyPath="yes" />
      </Component>

      <!-- ───────────────────────────────────────────────────────────────────
           Registry-based demand-load (Brian #10 follow-up).

           PackageContents.xml-driven bundle autoloading silently fails on
           BricsCAD V25 (see bricscad-v25-loader-quirks memory). We register
           the .NET assembly via the AutoCAD-style Applications registry hive,
           which BricsCAD reads at startup and NETLOADs without going through
           bundle manifest parsing.

             LOADCTRLS = 14 (0x0E) → load at startup + on command + on demand
             MANAGED   = 1        → .NET assembly (not native ARX)
             LOADER    → absolute path to the version-specific DLL

           Per-user install: HKCU not HKLM (no admin), LOADER under
           [LocalAppDataFolder] = %LOCALAPPDATA%. BricsCAD's HKLM Applications
           scan also reads HKCU (mirrors AutoCAD behaviour); verified working
           against V25 2026-06-17.

           Conditional on the corresponding BRICSCAD_VXX_FOUND search property
           so we don't litter the registry of hosts that aren't installed.
           ─────────────────────────────────────────────────────────────────── -->
      <Component Id="C_RegV25" Directory="BundleV25SubFolder" Condition="BRICSCAD_V25_FOUND">
        <RegistryKey Root="HKCU" Key="Software\Bricsys\BricsCAD\V25x64\en_US\Applications\AirenoOS">
          <RegistryValue Type="string"  Name="DESCRIPTION" Value="AirenoOS metadata sync (V25)" />
          <RegistryValue Type="integer" Name="LOADCTRLS"   Value="14" />
          <RegistryValue Type="string"  Name="LOADER"      Value="[LocalAppDataFolder]Bricsys\ApplicationPlugins\AirenoOS.BricsCAD.bundle\Contents\V25\AirenoOS.BricsCAD.Plugin.dll" />
          <RegistryValue Type="integer" Name="MANAGED"     Value="1" KeyPath="yes" />
        </RegistryKey>
      </Component>

      <Component Id="C_RegV26" Directory="BundleV26SubFolder" Condition="BRICSCAD_V26_FOUND">
        <RegistryKey Root="HKCU" Key="Software\Bricsys\BricsCAD\V26x64\en_US\Applications\AirenoOS">
          <RegistryValue Type="string"  Name="DESCRIPTION" Value="AirenoOS metadata sync (V26)" />
          <RegistryValue Type="integer" Name="LOADCTRLS"   Value="14" />
          <RegistryValue Type="string"  Name="LOADER"      Value="[LocalAppDataFolder]Bricsys\ApplicationPlugins\AirenoOS.BricsCAD.bundle\Contents\V26\AirenoOS.BricsCAD.Plugin.dll" />
          <RegistryValue Type="integer" Name="MANAGED"     Value="1" KeyPath="yes" />
        </RegistryKey>
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
