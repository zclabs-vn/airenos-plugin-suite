<?xml version="1.0" encoding="utf-8"?>
<!--
  BricsCAD plugin manifest. BricsCAD scans every *.bundle folder under
  C:\Program Files\Bricsys\ApplicationPlugins\ and auto-NETLOADs the
  ComponentEntry whose RuntimeRequirements match the host.

  Single Components block — exact shape v1.0.0 shipped with, which BricsCAD
  V26 already auto-loaded successfully. The ModuleName points at the V25
  (net48) subfolder because V25 hosts plugins on .NET Framework 4.x CLR;
  V26 (net8) cannot load that DLL and must be tested separately once V25
  bundle scanning is confirmed working.
-->
<ApplicationPackage
    SchemaVersion="1.0"
    AppVersion="1.0.3"
    Author="AirenoOS"
    Name="AirenoOS"
    Description="AirenoOS metadata sync — extracts blocks, layers, dimensions, text on save and POSTs to the MCP endpoint.">

  <CompanyDetails Name="AirenoOS" Url="https://zclabs.vn" Email="admin@zclabs.dev" />

  <Components>
    <RuntimeRequirements OS="Win64" Platform="BricsCAD" />
    <ComponentEntry
        AppName="AirenoOS"
        ModuleName="./Contents/V25/AirenoOS.BricsCAD.Plugin.dll"
        AppDescription="AirenoOS metadata sync"
        LoadOnAppearance="True"
        LoadOnCommandInvocation="False" />
  </Components>
</ApplicationPackage>
