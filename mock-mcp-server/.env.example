# ── Runtime config (copied to /opt/aireno-mock-mcp/.env on first deploy) ─────

# Port the server listens on (inside the container — VPS host port comes from compose).
PORT=5099

# Optional allowlist of accepted bearer tokens, comma-separated.
# Leave empty to accept any non-empty token (dev / open demo mode).
ALLOWED_TOKENS=

# Directory inside the container where payloads are persisted.
DATA_DIR=./data

# Maximum number of payloads to keep in the in-memory list (oldest are evicted).
MAX_INDEX_SIZE=500
