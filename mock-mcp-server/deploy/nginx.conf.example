# nginx vhost for mock-mcp.demo-hub.dev — installed on the VPS one time.
# Pattern matches the staircraft.demo-hub.dev vhost on the same host.
#
# Install:
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/mock-mcp.demo-hub.dev
#   sudo ln -sf /etc/nginx/sites-available/mock-mcp.demo-hub.dev /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Issue cert (after the HTTP-only block below is active):
#   sudo certbot --nginx -d mock-mcp.demo-hub.dev
#
# Certbot rewrites this file in place — adds the listen 443 / SSL block and
# the HTTP→HTTPS redirect. The version checked into git stays HTTP-only so
# it can be replayed cleanly on another host.

server {
    server_name mock-mcp.demo-hub.dev;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Plugin payloads can be large (drawings with thousands of objects).
    client_max_body_size 50m;

    location / {
        proxy_pass http://127.0.0.1:5099;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    listen 80;
    listen [::]:80;
}
